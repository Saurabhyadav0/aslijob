# ==============================================================================
# AsliJob — Master Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env.local and populate with your production values.
# Real values must never be committed to Git.
# ==============================================================================

# --- Core Web App & Privacy ---
NEXT_PUBLIC_BASE_URL=https://aslijob.vercel.app
NODE_ENV=production
DEMO_MODE=true
IDENTIFIER_SALT=aslijob_secure_salt_2026

# --- Supabase Database (Postgres, Storage, Auth) ---
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- TigerGraph Fraud Graph Cluster ---
TG_HOST=https://your-subdomain.i.tgcloud.io
TIGERGRAPH_HOST=https://your-subdomain.i.tgcloud.io
TG_GRAPH_NAME=FraudGraph
TIGERGRAPH_GRAPH=FraudGraph
TG_SECRET=
TIGERGRAPH_SECRET=

# --- AI Models (Gemini Multimodal Vision & Audio Analysis) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# --- Telegram Bot (@AsliJobBot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_SECRET=

# --- WhatsApp Cloud API Bot ---
WHATSAPP_VERIFY_TOKEN=aslijob_verify_token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Dodo Payments & Subscriptions ---
DODO_API_KEY=
DODO_PRODUCT_ID=pdt_0NqorZWwGmzJKNIvfznVx
DODO_PAYMENTS_WEBHOOK_SECRET=aslijob_dodo_webhook_secret_2026

# --- Web3 Onchain Verification (Ethereum Sepolia & Base EAS) ---
NEXT_PUBLIC_VERIFIER_CONTRACT_ADDRESS=0x6Fbc36723310fec0489Ec946A1975d68cAA1D50f
NEXT_PUBLIC_DEPLOY_TX=0xa910e4ded6de19828499c9a4c2979032cad12fe643fb561668df35f05586fea1
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
BASE_RPC_URL=https://sepolia.base.org
