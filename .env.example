# AsliJob — environment variable names only. Never commit real values.
# With no model key set, the check pipeline runs in rules-only mode.

# AI models (credits via AI Grants India)
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Supabase (Postgres, auth, storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TigerGraph (fraud graph)
TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH=
TIGERGRAPH_TOKEN=

# Bots
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Automations / payments
VIASOCKET_WEBHOOK_URL=
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# Web3 (EAS on Base & Custom Verifier on Sepolia)
BASE_RPC_URL=
EAS_SCHEMA_UID=
ISSUER_PRIVATE_KEY=
NEXT_PUBLIC_VERIFIER_CONTRACT_ADDRESS=
NEXT_PUBLIC_DEPLOY_TX=
NEXT_PUBLIC_EXPLORER_URL=

# Languages / analytics
BHASHINI_API_KEY=
POSTHOG_KEY=
SENTRY_DSN=

# Demo switch: replaces company check, payments and any missing AI key with demo data
DEMO_MODE=true
