# ==============================================================================
# AsliJob — Environment Variables Reference (.env.example)
# ==============================================================================
# Instructions: Copy this file to .env.local and fill in your values.
# Note: AsliJob is resilient by default. If external AI, Graph, or Web3 keys are
# not set, the platform operates gracefully in rules-only + Postgres fallback mode.
# ==============================================================================

# --- Core App & Host ---
NEXT_PUBLIC_BASE_URL=https://aslijob.vercel.app
DEMO_MODE=true
NODE_ENV=development
IDENTIFIER_SALT=aslijob-secure-salt-2026

# --- AI & Vision Models (Gemini / Multimodal Extraction) ---
# Used for parsing WhatsApp screenshots, PDF offer letters, and deepfake signals.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Supabase (Postgres Database, Auth, Realtime) ---
# Source of truth for scam reports, verified employers, dossiers, and subscriptions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- TigerGraph (Fraud Graph & Mule Syndicate Clustering) ---
# Host and authentication for TigerGraph cloud instance. Falls back to Postgres if down.
TIGERGRAPH_HOST=https://your-subdomain.i.tgcloud.io
TIGERGRAPH_GRAPH=FraudGraph
TIGERGRAPH_SECRET=
# Aliases supported:
TG_HOST=
TG_GRAPH_NAME=FraudGraph
TG_SECRET=

# --- Web3 Verification & Smart Contracts (Sepolia / Base EAS) ---
# Sepolia Verifier Contract: 0x6Fbc36723310fec0489Ec946A1975d68cAA1D50f
NEXT_PUBLIC_VERIFIER_CONTRACT_ADDRESS=0x6Fbc36723310fec0489Ec946A1975d68cAA1D50f
NEXT_PUBLIC_DEPLOY_TX=0x1bf519fa76a7751cbb58448ebf5fc430d4bf1743a411fa4ae0f1e16f3938be9d
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
BASE_RPC_URL=https://sepolia.base.org
EAS_SCHEMA_UID=0x4429188291000000000000000000000000000000000000000000000000000000
ISSUER_PRIVATE_KEY=

# --- Messaging Bots (Telegram & WhatsApp Cloud API) ---
# Telegram Bot (@AsliJobBot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_SECRET=

# WhatsApp Cloud API Webhook
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=aslijob_verify_token
WHATSAPP_PHONE_ID=

# --- B2B Billing & Checkout (Dodo Payments / Razorpay) ---
DODO_API_KEY=
DODO_PRODUCT_ID=pdt_0NqorZWwGmzJKNIvfznVx
DODO_PAYMENTS_WEBHOOK_SECRET=aslijob_dodo_webhook_secret_2026

# --- Background Cron Jobs & Automation ---
# Protects daily Merkle batch anchor cron: POST /api/cron/attest
CRON_SECRET=
# Automated 1930 dispatch / webhook forwarding
VIASOCKET_WEBHOOK_URL=
