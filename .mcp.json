{
  "_comment": "MCP servers for AsliJob development. Replace each 'command'/'args'/'env' with the exact install command the provider documents, then remove this comment. Keys here are the servers the build plan calls for.",
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase", "--project-ref", "<PROJECT_REF>"],
      "env": { "SUPABASE_ACCESS_TOKEN": "" }
    },
    "tigergraph": {
      "command": "npx",
      "args": ["-y", "<tigergraph-mcp-package>"],
      "env": { "TIGERGRAPH_HOST": "", "TIGERGRAPH_TOKEN": "" }
    },
    "viasocket": {
      "command": "npx",
      "args": ["-y", "<viasocket-mcp-package>"],
      "env": { "VIASOCKET_API_KEY": "" }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "" }
    },
    "vercel": {
      "command": "npx",
      "args": ["-y", "<vercel-mcp-package>"],
      "env": { "VERCEL_TOKEN": "" }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp"]
    }
  }
}
